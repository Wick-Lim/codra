{
  "name": "codra",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "pnpm --filter @codra/desktop dev",
    "postinstall": "pnpm --filter @codra/desktop exec electron-builder install-app-deps && node scripts/ensure-node-pty-helper-mode.mjs",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm build && playwright test --project=dev-electron",
    "test:packaged": "playwright test --project=packaged-electron",
    "package:archive": "node scripts/archive-host-app.mjs",
    "firebase:emulators": "pnpm --filter @codra/protocol build && pnpm --filter @codra/functions build && pnpm run stage:functions-deploy && pnpm --dir functions-deploy-build install --frozen-lockfile && firebase emulators:start --config firebase.json --project demo-codra",
    "test:firebase-rules": "pnpm --filter @codra/firebase test:rules",
    "stage:functions-deploy": "node scripts/stage-functions-deploy.mjs",
    "test:functions-deploy-artifact": "node scripts/test-functions-deploy-artifact.mjs",
    "build:release-candidate": "node scripts/build-codra-release-candidate.mjs",
    "verify:release-candidate": "node scripts/verify-codra-release-candidate.mjs",
    "test:firebase-claim-canary": "node scripts/run-firebase-claim-canary.mjs",
    "resume:firebase-claim-canary": "node scripts/resume-firebase-claim-canary.mjs",
    "test:resume-firebase-claim-canary": "node scripts/test-resume-firebase-claim-canary.mjs",
    "test:remote-direct": "playwright test tests/e2e/remote-direct.spec.ts",
    "test:remote-reconnect": "playwright test tests/e2e/remote-reconnect.spec.ts",
    "build:remote-test": "pnpm --filter @codra/desktop build:remote-test",
    "package:remote-test": "node scripts/package-remote-test.mjs",
    "verify:native-package": "node scripts/verify-node-datachannel-package.mjs",
    "verify:remote-build-config": "node scripts/verify-remote-build-config.mjs",
    "verify:firebase-indexes": "node scripts/verify-firebase-indexes.mjs",
    "scan:client-artifacts": "node scripts/scan-client-artifacts.mjs",
    "test:release-remote-disabled": "playwright test tests/e2e/release-remote-disabled.spec.ts",
    "verify:remote-release": "node scripts/verify-remote-release.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@firebase/rules-unit-testing": "5.0.1",
    "electron-builder": "26.15.3",
    "eslint": "10.8.0",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "firebase-admin": "14.2.0",
    "firebase-tools": "15.25.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  }
}
